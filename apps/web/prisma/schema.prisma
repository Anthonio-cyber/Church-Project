model Event {
  id                   String          @id @default(uuid()) @db.Uuid
  slug                 String          @unique
  title                String
  description          String
  category             String
  startsAt             DateTime
  endsAt               DateTime?
  mode                 EventMode       @default(PHYSICAL)
  location             String?
  onlineUrl            String?
  speaker              String?
  bannerUrl            String?
  capacity             Int?
  registrationDeadline DateTime?
  status               ContentStatus   @default(DRAFT)
  visibility           Visibility      @default(PUBLIC)
  ministryCenterId     String?         @db.Uuid
