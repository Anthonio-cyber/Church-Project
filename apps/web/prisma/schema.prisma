model Course {
  id                 String          @id @default(uuid()) @db.Uuid
  slug               String          @unique
  title              String
  track              String
  summary            String
  description        String
  thumbnailUrl       String?
  difficulty         String          @default("Foundational")
  language           String          @default("en")
  status             ContentStatus   @default(DRAFT)
  visibility         Visibility      @default(MEMBERS_ONLY)
  ministryCenterId   String?         @db.Uuid
  ministryCenter     MinistryCenter? @relation(fields: [ministryCenterId], references: [id], onDelete: SetNull)
  authorName         String
  scriptureRefs      String[]        @default([])
  tags               String[]        @default([])
  certificateEnabled Boolean         @default(false)
  publishedAt        DateTime?
  createdById        String?         @db.Uuid
  approvedById       String?         @db.Uuid
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  lessons  Lesson[]
  progress CourseProgress[]

  @@index([status])
  @@map("courses")
}

model Lesson {
  id               String   @id @default(uuid()) @db.Uuid
  courseId         String   @db.Uuid
  course           Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  orderIndex       Int
  title            String
  summary          String
  body             String
  videoUrl         String?
  audioUrl         String?
  pdfUrl           String?
  scriptureRefs    String[] @default([])
  quiz             Json?
  estimatedMinutes Int      @default(15)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  progress LessonProgress[]

  @@unique([courseId, orderIndex])
  @@map("lessons")
}

model CourseProgress {
  id                  String    @id @default(uuid()) @db.Uuid
  userId              String    @db.Uuid
  user                User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  courseId            String    @db.Uuid
  course              Course    @relation(fields: [courseId], references: [id], onDelete: Cascade)
  percentComplete     Int       @default(0)
  startedAt           DateTime  @default(now())
  completedAt         DateTime?
  certificateIssuedAt DateTime?
  lastActivityAt      DateTime  @default(now())

  lessons LessonProgress[]

  @@unique([userId, courseId])
  @@map("course_progress")
}

model LessonProgress {
  id               String         @id @default(uuid()) @db.Uuid
  courseProgressId String         @db.Uuid
  courseProgress   CourseProgress @relation(fields: [courseProgressId], references: [id], onDelete: Cascade)
  lessonId         String         @db.Uuid
  lesson           Lesson         @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  completedAt      DateTime?
  quizScore        Int?

  @@unique([courseProgressId, lessonId])
  @@map("lesson_progress")
}

model Resource {
  id               String          @id @default(uuid()) @db.Uuid
  slug             String          @unique
  title            String
  description      String
  body             String?
  type             ResourceType
  topic            String
