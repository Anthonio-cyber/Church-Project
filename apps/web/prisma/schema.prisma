  reason            String
  startedAt         DateTime  @default(now())
  expiresAt         DateTime
  endedAt           DateTime?
  subjectNotifiedAt DateTime?

  @@index([subjectId])
  @@map("support_mode_sessions")
}

model PlatformSetting {
  key         String   @id
  value       Json
  description String?
  updatedById String?  @db.Uuid
  updatedAt   DateTime @updatedAt

  @@map("platform_settings")
}

model RateLimitCounter {
  id          String   @id @default(uuid()) @db.Uuid
  bucket      String
  identity    String
  count       Int      @default(0)
  windowStart DateTime @default(now())

  @@unique([bucket, identity])
  @@map("rate_limit_counters")
}

/// What a stored file is for. The purpose decides who may read it back, so a
/// new purpose must come with a matching rule in the file-serving route rather
/// than inheriting whatever the last one allowed.
enum StoredFilePurpose {
  AVATAR
}

/// Uploaded files, held in the database rather than an object store.
///
/// This keeps the platform free to run and private by construction: a file is
/// only ever reachable through an authenticated route that applies the rule for
/// its purpose, so there is no public bucket URL to leak or guess. The trade is
/// size — the database is the wrong home for large media, so uploads are capped
/// and only small images are accepted today. Moving to object storage later
/// means changing lib/domain/files.ts, not every call site.
model StoredFile {
  id          String            @id @default(uuid()) @db.Uuid
  ownerId     String?           @db.Uuid
  owner       User?             @relation("FileOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  purpose     StoredFilePurpose
  /// Never the client's declared type — set from the bytes themselves.
  contentType String
  byteSize    Int
  data        Bytes
  createdAt   DateTime          @default(now())

  @@index([ownerId, purpose])
  @@map("stored_files")
}
