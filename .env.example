# ─────────────────────────────────────────────────────────────────────────────
# 𝒾Pastor — environment configuration
#
# Copy to .env and fill in. NEVER commit a real .env file.
# Generate each secret with:  openssl rand -base64 48
# ─────────────────────────────────────────────────────────────────────────────

# ── Required ────────────────────────────────────────────────────────────────

# ONE PostgreSQL database holds the whole platform. The separation between
# member data, counselling, safeguarding, moderation and audit is enforced by
# schema design, permissions and application guards — not by separate servers.
# Managed Postgres from any provider works; add ?sslmode=require in production.
DATABASE_URL="postgresql://user:password@host:5432/ipastor?schema=public&sslmode=require"

# Signs session tokens and verification tokens. Changing it signs everyone out.
AUTH_SECRET="change-me-openssl-rand-base64-48"

# Encrypts counselling notes and safeguarding narratives at rest (AES-256-GCM).
# LOSING THIS MEANS LOSING ACCESS TO THAT CONTENT PERMANENTLY. Back it up
# somewhere separate from the database, and never rotate it without first
# re-encrypting existing rows.
DATA_ENCRYPTION_KEY="change-me-openssl-rand-base64-48"

# The public origin of the deployment. Used in email links, the PWA manifest and
# the same-origin check. Must match the domain people actually visit.
NEXT_PUBLIC_APP_URL="https://ipastor.org"

# ── Branding (optional) ─────────────────────────────────────────────────────
NEXT_PUBLIC_BRAND_NAME="iPastor"
# NEXT_PUBLIC_BRAND_LOGO_URL="https://cdn.example.org/logo.svg"

# ── Integrations (optional) ─────────────────────────────────────────────────
# Each is optional. Where one is absent the platform says so honestly in the
# admin system monitor rather than pretending the service is working.

# Transactional email. Without it, verification and reset links are logged to
# the server console and shown in the response in development.
EMAIL_API_KEY=""
EMAIL_API_URL="https://api.resend.com/emails"
EMAIL_FROM="iPastor <no-reply@ipastor.org>"

# Push notifications for the Android and iOS apps (Expo access token).
PUSH_NOTIFICATION_KEY=""

# Realtime. The built-in Server-Sent Events hub needs no configuration and is
# complete for a single instance. Set this only when running several instances
# behind a shared broker.
REALTIME_SECRET=""

# Voice and video for counselling sessions. Without it, sessions run as written
# conversations and the interface says voice and video are unavailable.
VIDEO_SERVICE_KEY=""
VIDEO_SERVICE_URL=""

# Private file storage for uploads.
STORAGE_KEY=""
STORAGE_BUCKET=""

# Backup schedule, e.g. "0 3 * * *". Reported in the admin system monitor.
BACKUP_SCHEDULE=""

# ── Seeding (optional) ──────────────────────────────────────────────────────
# Override the demo passwords. ALWAYS set these before seeding anything
# reachable from the internet, and remove the demo accounts before real use.
SEED_DEMO_PASSWORD=""
SEED_ADMIN_PASSWORD=""

# ── Mobile ──────────────────────────────────────────────────────────────────
# Set in apps/mobile/eas.json per build profile rather than here.
# EXPO_PUBLIC_API_URL="https://ipastor.org"
