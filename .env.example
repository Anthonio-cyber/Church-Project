# ─────────────────────────────────────────────────────────────────────────────
# 𝒾Pastor — environment configuration
#
# Copy to .env and fill in. NEVER commit a real .env file.
# Generate each secret with:  openssl rand -base64 48
# ─────────────────────────────────────────────────────────────────────────────

# ── Required ────────────────────────────────────────────────────────────────

# ONE PostgreSQL database holds the whole platform. The separation between
# member data, counselling, safeguarding, moderation and audit is enforced by
# schema design, permissions and application guards — not by separate servers.
# Managed Postgres from any provider works; add ?sslmode=require in production.
DATABASE_URL="postgresql://user:password@host:5432/ipastor?schema=public&sslmode=require"

# Signs session tokens and verification tokens. Changing it signs everyone out.
AUTH_SECRET="change-me-openssl-rand-base64-48"

# Encrypts counselling notes and safeguarding narratives at rest (AES-256-GCM).
# LOSING THIS MEANS LOSING ACCESS TO THAT CONTENT PERMANENTLY. Back it up
# somewhere separate from the database, and never rotate it without first
# re-encrypting existing rows.
DATA_ENCRYPTION_KEY="change-me-openssl-rand-base64-48"

# The public origin of the deployment. Used in email links, the PWA manifest and
# the same-origin check. Must match the domain people actually visit.
NEXT_PUBLIC_APP_URL="https://ipastor.church"

# ── Branding (optional) ─────────────────────────────────────────────────────
NEXT_PUBLIC_BRAND_NAME="iPastor"
# NEXT_PUBLIC_BRAND_LOGO_URL="https://cdn.example.org/logo.svg"

# ── Integrations (optional) ─────────────────────────────────────────────────
# Each is optional. Where one is absent the platform says so honestly in the
# admin system monitor rather than pretending the service is working.

# Transactional email. Without it, verification and reset links are logged to
# the server console and shown in the response in development.
EMAIL_API_KEY=""
EMAIL_API_URL="https://api.resend.com/emails"
EMAIL_FROM="iPastor <no-reply@ipastor.church>"

# Push notifications for the Android and iOS apps (Expo access token).
PUSH_NOTIFICATION_KEY=""

# Realtime. The built-in Server-Sent Events hub needs no configuration and is
# complete for a single instance. Set this only when running several instances
# behind a shared broker.
REALTIME_SECRET=""

# Voice and video for counselling sessions. Set VIDEO_SERVICE_URL to a Jitsi
# instance — "https://meet.jit.si" is free and needs no account — and calls
# appear inside voice/video sessions. Left empty, those sessions run as written
# conversations and the interface says so.
#
# A public Jitsi instance has no accounts: the room name is the only secret, so
# it is derived as an HMAC of the session id under AUTH_SECRET. That makes the
# room unguessable, but anyone who obtains the link can still join. For
# authenticated rooms, point this at a self-hosted Jitsi with JWT enabled.
VIDEO_SERVICE_URL=""
# Only used by a provider that requires one. A public Jitsi instance does not.
VIDEO_SERVICE_KEY=""

# File uploads need no configuration and no third-party account: they are held
# in the platform's own database and served through an authenticated route, so
# there is no public bucket URL to leak. Uploads are capped and restricted to
# small images, because a database is the wrong home for large media. To move
# to object storage later, replace src/lib/domain/files.ts.

# Push notifications to browsers (Web Push). Generate a pair once with:
#   node -e "console.log(require('web-push').generateVAPIDKeys())"
# The public key is served to the browser by design — it is what the
# subscription encrypts to. The private key signs; keep it secret.
# Without both, browser notifications stay off and the interface says so.
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""

# Backups are taken by an administrator from Admin → Security, which downloads
# a complete export. There is no key: a backup that lives inside the thing it
# is backing up would not be a backup, so it is handed to a person to keep
# elsewhere. BACKUP_SCHEDULE below records the routine your organisation
# actually follows, for the system monitor to report.

# Backup schedule, e.g. "0 3 * * *". Reported in the admin system monitor.
BACKUP_SCHEDULE=""

# ── Seeding (optional) ──────────────────────────────────────────────────────
# The seed script creates one Super Admin account and nothing else. ALWAYS
# override these before seeding anything reachable from the internet, and
# change the password on first sign-in regardless.
SEED_SUPER_ADMIN_EMAIL=""
SEED_SUPER_ADMIN_PASSWORD=""

# ── Mobile ──────────────────────────────────────────────────────────────────
# Set in apps/mobile/eas.json per build profile rather than here.
# EXPO_PUBLIC_API_URL="https://ipastor.church"
